# ======================
# Database Configuration
# ======================
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/your_database_name?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
db.username=your_database_user
db.password=your_database_password
db.pool.maxSize=5
db.pool.minIdle=1
db.pool.connectionTimeoutMs=3000
db.pool.idleTimeoutMs=60000
db.pool.maxLifetimeMs=1800000

# ======================
# Security
# ======================
security.password.algorithm=SHA-256
security.session.timeout=1800

# ======================
# Calendar
# ======================
calendar.slot.minutes=30
calendar.start.hour=08
calendar.end.hour=20

# ======================
# Application
# ======================
app.name=Fisio e Sports
app.version=1.0
app.environment=development

# ======================
# WhatsApp
# ======================
# Servizio WhatsApp locale.
# Se therapistId resta vuoto, il servizio e abilitato per tutti i terapisti.
whatsapp.baileys.enabled=false
whatsapp.baileys.therapistId=
whatsapp.baileys.gatewayBaseUrl=http://127.0.0.1:3001
whatsapp.baileys.gatewayTimeoutMs=4000
whatsapp.baileys.serviceDirectory=/opt/baileys-service
